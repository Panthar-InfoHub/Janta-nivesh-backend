model Bundle {
  id              String          @id @default(cuid())
  bundle_name     String
  bundle_products BundleProduct[]
}

model BundleProduct {
  id                    String    @id @default(cuid())
  bundle_id             String
  mf_product_id         String
  allocation_percentage Float
  min_amount            Decimal?  @db.Decimal(12, 4)
  bundle                Bundle    @relation(fields: [bundle_id], references: [id], onDelete: Cascade)
  mf_product            MfProduct @relation(fields: [mf_product_id], references: [id], onDelete: Cascade)
}
