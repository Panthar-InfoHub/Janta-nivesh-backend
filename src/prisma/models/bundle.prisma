enum BundleInvestmentType {
  DAILY_SIP
  MONTHLY_SIP
  LUMPSUM
}

model Bundle {
  id                   String           @id @default(cuid())
  bundle_name          String
  bundle_description   String
  is_published         Boolean          @default(false)
  equity_percentage    Float?           @default(0)
  commodity_percentage Float?           @default(0)
  debt_percentage      Float?           @default(0)
  hybrid_percentage    Float?           @default(0)
  img_url              String?
  hex                  String?
  meta_data            Json?
  types                BundleType[]
}

model BundleType {
  id              String               @id @default(cuid())
  bundle_id       String
  investment_type BundleInvestmentType
  start_amount    Float
  bundle          Bundle               @relation(fields: [bundle_id], references: [id], onDelete: Cascade)
  categories      BundleCategory[]

  @@unique([bundle_id, investment_type])
  @@index([bundle_id])
}

model BundleCategory {
  id               String               @id @default(cuid())
  bundle_type_id   String
  category_name    String
  display_name     String
  total_percentage Float
  bundle_type      BundleType           @relation(fields: [bundle_type_id], references: [id], onDelete: Cascade)
  slots            BundleCategorySlot[]

  @@index([bundle_type_id])
}

model BundleCategorySlot {
  id                      String         @id @default(cuid())
  bundle_category_id      String
  allocation_percentage   Float
  default_rank            Int
  pre_selected_product_id String?
  pre_selected_product    MfProduct?     @relation(fields: [pre_selected_product_id], references: [id], onDelete: SetNull)
  bundle_category         BundleCategory @relation(fields: [bundle_category_id], references: [id], onDelete: Cascade)

  @@index([pre_selected_product_id])
}
