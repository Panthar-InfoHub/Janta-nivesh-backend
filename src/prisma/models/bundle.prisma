model Bundle {
  id                   String           @id @default(cuid())
  bundle_name          String
  bundle_description   String
  equity_percentage    Float?           @default(0)
  commodity_percentage Float?           @default(0)
  debt_percentage      Float?           @default(0)
  hybrid_percentage    Float?           @default(0)
  meta_data            Json?
  categories           BundleCategory[]
}

model BundleCategory {
  id               String               @id @default(cuid())
  bundle_id        String
  category_name    String
  display_name     String
  total_percentage Float
  bundle           Bundle               @relation(fields: [bundle_id], references: [id], onDelete: Cascade)
  slots            BundleCategorySlot[]
}

model BundleCategorySlot {
  id                    String         @id @default(cuid())
  bundle_category_id    String
  allocation_percentage Float
  default_rank          Int
  bundle_category       BundleCategory @relation(fields: [bundle_category_id], references: [id], onDelete: Cascade)
}
