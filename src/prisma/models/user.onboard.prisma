model UserFinance {
  id                     String   @id @default(cuid())
  user_id                String   @unique
  annual_income          String   @default("0.00")
  expense_house          String   @default("0.00")
  expense_food           String   @default("0.00")
  expense_transportation String   @default("0.00")
  expense_others         String   @default("0.00")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt
  user                   User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model UserBankDetails {
  id                        String      @id @default(cuid())
  user_id                   String
  account_no                String
  account_no_hash           String      @default("")
  ifsc_code                 String
  bank_name                 String?
  account_type              String?
  account_holder_name       String? // as returned by penny drop / UPI verification
  fp_bank_account_id        String?     @unique // FP bank_account object id (bac_...) - used by folio_defaults.payout_bank_account
  fp_bank_account_old_id    Int? // same FP object's numeric old_id - what mandate creation's bank_account_id wants
  is_primary                Boolean     @default(false)
  verification_status       StageStatus @default(PENDING)
  verification_method       String? // e.g. "PENNY_DROP"
  verified_at               DateTime?
  provider_reference_id     String? // penny drop transaction / provider ref id
  raw_verification_response Json?
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @default(now()) @updatedAt
  user                      User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, account_no_hash], name: "user_account_no_idx")
}

model UserAssets {
  id           String   @id @default(cuid())
  user_id      String   @unique
  stocks       String   @default("0.00")
  fd           String   @default("0.00")
  real_estate  String   @default("0.00")
  gold         String   @default("0.00")
  cash_saving  String   @default("0.00")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  mutual_funds String   @default("0.00")
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model UserInsurance {
  id               String   @id @default(cuid())
  user_id          String   @unique
  life_insurance   String   @default("0.00")
  health_insurance String   @default("0.00")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model UserLoan {
  id                 String   @id @default(cuid())
  user_id            String
  loan_type          String
  loan_name          String?
  outstanding_amount String   @default("0.00")
  monthly_emi        String   @default("0.00")
  tenure_months      Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, loan_type], name: "user_loan_type_idx")
}

enum GoalAssetSubtype {
  BIKE
  SCOOTER
  CAR
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  DELETED
}

model UserGoals {
  id           String @id @default(uuid())
  user_id      String
  goal_type_id Int    @db.SmallInt
  goal_name    String @db.VarChar(60)

  // Specific Goal Type Attributes
  child_name    String?           @db.VarChar(50)
  child_age     Int?              @db.SmallInt
  asset_subtype GoalAssetSubtype?

  years_remaining Int       @db.SmallInt
  target_date     DateTime? @db.Date

  // Financial Inputs
  current_cost    Decimal? @db.Decimal(18, 2)
  target_amount   Decimal? @db.Decimal(18, 2)
  current_savings Decimal  @default(0) @db.Decimal(18, 2)

  // Snapshot Rates applied at creation
  inflation_rate       Decimal? @db.Decimal(7, 4)
  expected_return_rate Decimal  @db.Decimal(7, 4)

  // Computed Projections Snapshot
  future_target_amount   Decimal @db.Decimal(18, 2)
  fv_current_savings     Decimal @default(0) @db.Decimal(18, 2)
  net_required_corpus    Decimal @db.Decimal(18, 2)
  required_monthly_sip   Decimal @db.Decimal(18, 2)
  required_lumpsum_today Decimal @db.Decimal(18, 2)

  status              GoalStatus @default(ACTIVE)
  calculation_version String     @default("v2.0") @db.VarChar(20)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, status])
  @@index([user_id, goal_type_id], map: "user_goal_type_idx")
  @@map("user_goal")
}

model GoalCalculationConfig {
  id                   String   @id @default(uuid())
  goal_type_id         Int      @unique @db.SmallInt
  inflation_rate       Decimal? @db.Decimal(7, 4)
  expected_return_rate Decimal  @db.Decimal(7, 4)
  min_years            Int      @db.SmallInt
  max_years            Int      @db.SmallInt
  active               Boolean  @default(true)
  config_version       String   @default("v2.0") @db.VarChar(20)
  effective_from       DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt

  @@map("goal_calculation_config")
}
