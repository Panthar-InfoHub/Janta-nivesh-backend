model UserFinance {
  id                     String   @id @default(cuid())
  user_id                String   @unique
  annual_income          String   @default("0.00")
  expense_house          String   @default("0.00")
  expense_food           String   @default("0.00")
  expense_transportation String   @default("0.00")
  expense_others         String   @default("0.00")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt
  user                   User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model UserBankDetails {
  id                        String      @id @default(cuid())
  user_id                   String
  account_no                String
  account_no_hash           String      @default("")
  ifsc_code                 String
  bank_name                 String?
  account_type              String?
  account_holder_name       String? // as returned by penny drop / UPI verification
  fp_bank_account_id        String?     @unique // FP bank_account object id (bac_...) - used by folio_defaults.payout_bank_account
  fp_bank_account_old_id    Int? // same FP object's numeric old_id - what mandate creation's bank_account_id wants
  is_primary                Boolean     @default(false)
  verification_status       StageStatus @default(PENDING)
  verification_method       String? // e.g. "PENNY_DROP"
  verified_at               DateTime?
  provider_reference_id     String? // penny drop transaction / provider ref id
  raw_verification_response Json?
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @default(now()) @updatedAt
  user                      User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, account_no_hash], name: "user_account_no_idx")
}

model UserAssets {
  id           String   @id @default(cuid())
  user_id      String   @unique
  stocks       String   @default("0.00")
  fd           String   @default("0.00")
  real_estate  String   @default("0.00")
  gold         String   @default("0.00")
  cash_saving  String   @default("0.00")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  mutual_funds String   @default("0.00")
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model UserInsurance {
  id               String   @id @default(cuid())
  user_id          String   @unique
  life_insurance   String   @default("0.00")
  health_insurance String   @default("0.00")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model UserLoan {
  id                 String   @id @default(cuid())
  user_id            String
  loan_type          String
  loan_name          String?
  outstanding_amount String   @default("0.00")
  monthly_emi        String   @default("0.00")
  tenure_months      Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, loan_type], name: "user_loan_type_idx")
}

model UserGoals {
  id                      String   @id @default(cuid())
  user_id                 String
  goal_id                 Int?
  goal_type_id            Int
  inflation_rate          Int
  return_rate             Int
  current_saved_amount    String   @default("0.00")
  goal_name               String?
  goal_item_id            Int?
  goal_item_name          String?
  child_name              String?
  child_age               Int?
  years_left              Int?
  current_goal_cost       String?
  current_age             Int?
  retirement_age          Int?
  life_expectancy         Int?
  current_monthly_expense String?
  post_retirement_return  String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @default(now()) @updatedAt
  user                    User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, goal_type_id], map: "user_goal_type_idx")
}
