model FdIssuer {
  id                String      @id @default(cuid())
  full_name         String
  display_name      String
  issuer_type       IssuerType
  logo_url          String
  banner_url        String
  rating_text       String?
  customer_served   String
  operating_since   String?
  about_description String
  support_email     String
  support_phone     String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  products          FdProduct[]
}

model FdProduct {
  id                        String           @id @default(cuid())
  issuer_id                 String
  type                      String
  min_deposit               Decimal          @default(0.00) @db.Decimal(12, 2)
  max_deposit               Decimal          @default(0.00) @db.Decimal(12, 2)
  min_tenure_days           Int
  max_tenure_days           Int
  lock_in_period_days       Int
  withdrawal_message        String
  premature_penalty_percent Float
  is_vkyc_required          Boolean          @default(false)
  min_amount_for_vkyc       Decimal          @default(0.00) @db.Decimal(12, 2)
  usps                      Json?
  faqs                      Json?
  tags                      Json?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  interest_rates            FdInterestRate[]
  issuer                    FdIssuer         @relation(fields: [issuer_id], references: [id], onDelete: Cascade)
  fdTransactions            FdTransaction[]

  @@unique([issuer_id, type])
}

model FdInterestRate {
  id                   String            @id @default(cuid())
  fd_product_id        String
  payout_frequency     FdPayoutFrequency
  customer_type        FdCustomerType
  tenure_days          Int
  tenure_label         String
  interest_rate        Decimal           @db.Decimal(5, 2)
  annualized_yield     Decimal           @db.Decimal(5, 2)
  is_default_selection Boolean           @default(false)
  is_tax_saver         Boolean?
  last_updated_at      DateTime          @default(now())
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  product              FdProduct         @relation(fields: [fd_product_id], references: [id], onDelete: Cascade)

  @@unique([fd_product_id, payout_frequency, tenure_label, customer_type])
}

model FdTransaction {
  id                   String            @id @default(cuid())
  user_id              String
  product_id           String
  issuer_id            String?
  amount               Decimal           @db.Decimal(12, 2)
  roi_at_booking       Decimal?          @db.Decimal(5, 2)
  tenure_at_booking    Int?
  payout_frequency     FdPayoutFrequency
  status               TransactionStatus @default(INITIATED)
  is_vkyc_required     Boolean           @default(false)
  is_nominee_added     Boolean           @default(false)
  payment_tx_id        String?           @unique
  bank_name_added      String?
  vkyc_failure_reason  String?
  vkyc_failed_by       String?
  fd_account_number    String?
  maturity_amount      Decimal?          @db.Decimal(12, 2)
  maturity_date        DateTime?
  maturity_instruction String?
  onboarded_at         DateTime?
  payment_completed_at DateTime?
  vkyc_completed_at    DateTime?
  fd_issued_at         DateTime?
  refund_date          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  failure_reason       String?
  is_vkyc_initiated    Boolean           @default(false)
  is_vkyc_pending      Boolean           @default(true)
  product              FdProduct         @relation(fields: [product_id], references: [id])
  user                 User              @relation(fields: [user_id], references: [id])
}

enum TransactionStatus {
  INITIATED
  ONBOARDING_COMPLETED
  ONBOARDING_FAILED
  PAYMENT_PENDING
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  VKYC_PENDING
  VKYC_COMPLETED
  VKYC_FAILED
  FD_CREATED
  REFUNDED
  MATURED
  PREMATURE_WITHDRAWN
}

enum FdPayoutFrequency {
  CUMULATIVE
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  ON_MATURITY
}

enum FdCustomerType {
  STANDARD
  SENIOR_CITIZEN
  FEMALE
  SENIOR_CITIZEN_FEMALE
}

enum IssuerType {
  BANK
  NBFC
}
