model User {
  id                String            @id @default(uuid())
  full_name         String?
  inv_id            Int?              @unique
  usr               String?           @unique
  pwd               String?
  email             String?           @unique
  phone_no          String?           @unique
  city              String?
  dob               DateTime?
  fcm_token         String?
  meta_data         Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt
  nse_client_code   String?           @unique
  refresh_token     String?
  mpin              String?
  fds               FdTransaction[]
  kyc_types         KycType[]
  mfKycIdentities   MfKycIdentity?
  user_assets       UserAssets?
  user_bank_details UserBankDetails[]
  user_finance      UserFinance?
  user_goals        UserGoals[]
  user_insurance    UserInsurance?
  user_loan         UserLoan[]
}
