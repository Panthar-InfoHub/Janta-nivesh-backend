enum Mandate_status {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id                String                 @id @default(uuid())
  full_name         String?
  inv_id            Int?                   @unique
  usr               String?                @unique
  pwd               String?
  email             String?                @unique
  email_hash        String?                @unique
  phone_no          String?                @unique
  phone_hash        String?                @unique
  city              String?
  dob               String?
  fcm_token         String?
  meta_data         Json?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @default(now()) @updatedAt
  nse_client_code   String?                @unique
  refresh_token     String?
  mpin              String?
  fds               FdTransaction[]
  kyc_types         KycType[]
  mfKycIdentities   MfKycIdentity?
  user_assets       UserAssets?
  user_bank_details UserBankDetails[]
  user_finance      UserFinance?
  user_goals        UserGoals[]
  user_insurance    UserInsurance?
  user_loan         UserLoan[]
  net_worth_history UserNetWorthSnapshot[]
  mandates          Mandate[]
  notifications     Notification[]
}

model UserNetWorthSnapshot {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  netWorth    String
  assets      String // Sum of MF + FD + Cash
  liabilities String // Sum of Loans
  month       Int // 1-12
  year        Int // 2024
  createdAt   DateTime @default(now())


  @@unique([userId, month, year]) // Prevents duplicate entries for the same month
}

model Mandate {
  id           String         @id @default(cuid())
  user_id      String
  mandate_id   String         @unique
  amount       Decimal        @db.Decimal(12, 2)
  status       Mandate_status @default(PENDING) // PENDING, SUCCESS, FAILED
  umrn         String?
  bank_account String?
  start_date   DateTime?
  end_date     DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt
  user         User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}
