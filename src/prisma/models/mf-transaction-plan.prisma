enum MfPlanType {
  PURCHASE
  REDEMPTION
  SWITCH
}

enum MfTransactionState {
  CREATED
  UNDER_REVIEW // one-shot orders start here - FP reviews asynchronously
  PENDING // review passed; awaiting consent + payment
  REVIEW_COMPLETED // plan equivalent of PENDING
  CONFIRMED
  SUBMITTED
  ACTIVE
  COMPLETED
  SUCCESSFUL
  FAILED
  CANCELLED
  REVERSED
}

// Single source of truth for every MF transaction a user makes - both systematic plans
// (SIP/SWP/STP, `systematic: true`, FP calls this family "FP Transaction Plans") and one-shot
// orders (lumpsum purchase/redemption/switch, `systematic: false`). `plan_type` says what kind
// of transaction it is; `systematic` says whether it recurs.
// Plan-only columns (frequency, installment_day, number_of_installments, the installment-date
// fields, auto_generate_installments, generate_first_installment_now) are simply null on
// one-shot rows - same nullable-per-type convention already used for REDEMPTION-only
// folio_number and SWITCH-only switch_to_scheme; per-type mandatory-ness is enforced in the zod
// schemas, not here.
// state is one shared enum across both families - plans move through
// CREATED -> REVIEW_COMPLETED -> CONFIRMED -> SUBMITTED -> ACTIVE -> COMPLETED, one-shot orders
// move through UNDER_REVIEW -> PENDING -> CONFIRMED -> SUBMITTED -> SUCCESSFUL/REVERSED - which
// subset applies depends on `systematic`. FP sends lowercase snake_case; map to this enum on write
// (see mf-transaction-plan.service.ts) rather than storing FP's raw casing.
// Note: the consent OTP itself is deliberately NOT stored - only who consented and when.
model MfTransactionPlan {
  id                    String     @id @default(cuid())
  user_id               String
  user                  User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  plan_type             MfPlanType
  fp_id                 String     @unique // FP's id for this row - mfpp_/mfrp_/mfsp_ for plans, mfp_ for one-shot orders
  fp_old_id             Int? // numeric id off the same object - what the older /api/pg/* surface wants (payments), same split as bank accounts
  fp_payment_id         String? // payment created against a one-shot order, mirrors Mandate.fp_payment_id
  mf_investment_account String // mfia_...

  // Link to the curated catalogue, resolved from `scheme` on write (mf-transaction-plan.service.ts).
  // Nullable: rows predating this column have none, and a fund can be absent from the catalogue.
  // onDelete Restrict, NOT Cascade - MfSchemePlan/MfNavHistory cascade because they're derived and
  // regenerable; transaction history is neither. Delisting a fund must never delete a user's orders.
  mf_product_id String?
  mf_product    MfProduct? @relation(fields: [mf_product_id], references: [id], onDelete: Restrict)

  scheme          String // ISIN - kept alongside the FK: it's what FP echoes and what payloads send
  folio_number    String? // required for REDEMPTION (can only redeem from a folio you hold)
  amount          Decimal? @db.Decimal(12, 2) // optional on one-shot redemption - see `units`
  units           Decimal? @db.Decimal(18, 4) // redeem-by-units; amount AND units both null = redeem the entire holding
  systematic      Boolean  @default(true) // false = one-shot order (lumpsum purchase/redemption/switch)
  frequency       String? // monthly | daily (redemption supports monthly only) - plan only, null for one-shot orders
  installment_day Int? // null for frequency = daily
  scheduled_on    DateTime?

  number_of_installments    Int? // plan only
  remaining_installments    Int?
  requested_activation_date DateTime?
  start_date                DateTime?
  end_date                  DateTime?
  next_installment_date     DateTime?
  previous_installment_date DateTime?

  state                          MfTransactionState
  auto_generate_installments     Boolean @default(true)
  generate_first_installment_now Boolean @default(false) // REDEMPTION only

  // PURCHASE only - redemptions pay out, no mandate involved
  payment_method String? // "mandate"
  payment_source String? // the mandate id
  purpose        String?

  // SWITCH only
  switch_to_scheme String?

  source_ref_id String?
  partner       String?
  gateway       String  @default("ondc")
  euin          String?
  user_ip       String?
  server_ip     String?
  initiated_by  String?
  initiated_via String?

  // Consent (attestation that investor confirmed the order) - OTP value itself not persisted
  consent_email    String?
  consent_isd_code String?
  consent_mobile   String?
  consent_given_at DateTime?

  // Settlement / allotment - populated by the RTA, so null until the order actually processes.
  // These are what a portfolio screen or contract note needs; without them a SUCCESSFUL order
  // tells you nothing about what the user actually got.
  traded_on         DateTime?
  submitted_at      DateTime?
  succeeded_at      DateTime?
  allotted_units    Decimal?  @db.Decimal(18, 4)
  allotted_nav_date DateTime?
  purchased_amount  Decimal?  @db.Decimal(14, 2)
  purchased_price   Decimal?  @db.Decimal(12, 4)

  fp_created_at             DateTime?
  activated_at              DateTime?
  cancelled_at              DateTime?
  cancellation_scheduled_on DateTime?
  cancellation_code         String?
  auto_cancelled            Boolean?
  failed_at                 DateTime?
  completed_at              DateTime?
  reason                    String?

  raw_response Json? // full FP payload, forward-compat escape hatch

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([user_id])
  @@index([user_id, plan_type])
  @@index([mf_product_id])
}
