model MfProduct {
  id                 String                    @id @default(cuid())
  scheme_id          String
  isin               String?
  img_url            String?                   @default("")
  mapping_code       String
  scheme_name        String
  amc_id             String?
  amc_code           String?
  amc_name           String?
  asset_type         String?
  scheme_type        String?
  structure          String?
  risk_name          String?
  risk_level         Int?
  latest_nav         Decimal?                  @db.Decimal(12, 4)
  latest_nav_date    DateTime?
  purchase_allowed   Boolean                   @default(false)
  sip_allowed        Boolean                   @default(false)
  redemption_allowed Boolean                   @default(false)
  switch_allowed     Boolean                   @default(false)
  maturity_date      DateTime?
  nfo_end_date       DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @default(now()) @updatedAt
  nse_scheme_code    String?
  platform_code      String?
  bundle_products    BundleProduct[]
  metrics            MfMetrics?
  nav_history        MfNavHistory[]
  transaction_rules  MfSchemeTransactionRules?

  @@unique([scheme_id, isin, nse_scheme_code])
  @@index([amc_code])
  @@index([scheme_type])
  @@index([latest_nav_date])
  @@index([risk_level])
  @@index([amc_name(ops: raw("gist_trgm_ops"))], map: "mf_amc_name_trgm_idx", type: Gist)
  @@index([scheme_name(ops: raw("gist_trgm_ops"))], map: "mf_scheme_name_trgm_idx", type: Gist)
}

model MfNavHistory {
  id            String    @id @default(cuid())
  mf_product_id String
  scheme_id     String
  nav           Decimal   @db.Decimal(12, 4)
  nav_date      DateTime
  daily_change  Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  mf_product    MfProduct @relation(fields: [mf_product_id], references: [id], onDelete: Cascade)

  @@unique([mf_product_id, nav_date])
  @@index([mf_product_id, nav_date])
}

model MfSchemeTransactionRules {
  id                    String    @id @default(uuid())
  mf_product_id         String    @unique
  sip_allowed_dates     Int[]
  sip_frequencies       String[]
  min_investment_amount Decimal   @default(0) @db.Decimal(12, 2)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt
  mf_product            MfProduct @relation(fields: [mf_product_id], references: [id], onDelete: Cascade)
}

model MfMetrics {
  id             String    @id @default(uuid())
  mf_product_id  String    @unique
  return_30d     Float? //1 month return
  return_90d     Float? //3 month return
  return_6m      Float? //6 month return
  return_1y      Float? //1 year return
  return_3y      Float? //3 year return
  nav_change_pct Float? // NAV change percentage
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  mf_product     MfProduct @relation(fields: [mf_product_id], references: [id], onDelete: Cascade)

  @@index([mf_product_id])
}
